# Seagate F3 Spin Down
# Sends the spin down (sleep) command to a Seagate F3 drive.
# Changes to level 2 and issues the Z command.
# Default baud: 38400, 8N1, no flow control.
#
# Use before:
#   - Transporting the drive
#   - Swapping PCB
#   - Safe hot-swap
#   - Preparing for imaging (spin down + remove power)

echo "============================================"
echo " Seagate F3 Spin Down"
echo "============================================"

if $gui_mode = 0
  serialopen /dev/ttyUSB0 38400
else
  serialopen
endif
usleep 200000

echo "Waking terminal (Ctrl+Z)..."
serialsend \x1a
usleep 500000

echo "--- Terminal Banner ---"
buffersize 1024
serialread 1024
printbuffer 0 1024

echo ""
echo "Changing to level 2..."
serialsend \x2f\x32\x0d
usleep 200000

echo "--- Level Change ---"
serialread 1024
printbuffer 0 1024

echo ""
echo "=== Spinning Down (Z) ==="
serialsend \x5a\x0d
usleep 500000

echo "--- Spin Down Response ---"
serialread 1024
printbuffer 0 1024

echo ""
echo "============================================"
echo " Drive should now be spun down (idle/standby)."
echo "============================================"

if $gui_mode = 0
  serialclose
endif
echo "=== Done ==="
end
